{
	"name": "nazha-dash-v2",
	"private": true,
	"version": "2.6.0",
	"type": "module",
	"engines": {
		"node": ">=22",
		"pnpm": ">=11"
	},
	"scripts": {
		"dev": "vite",
		"dev:mock": "node scripts/dev-mock.js",
		"dev:mock:guest": "node scripts/dev-mock.js --guest",
		"mock:server": "node scripts/mock-nezha-server.js",
		"mock:server:guest": "node scripts/mock-nezha-server.js --guest",
		"typecheck": "tsc -b",
		"build": "pnpm run typecheck && vite build",
		"lint": "biome lint",
		"lint:fix": "biome lint --fix",
		"format": "biome format --write .",
		"check": "biome check",
		"check:fix": "biome check --fix --unsafe",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"verify": "pnpm run check && pnpm run test:coverage && pnpm run build",
		"preview": "vite preview"
	},
	"dependencies": {
		"@fontsource/inter": "5.3.0",
		"@heroicons/react": "2.2.0",
		"@radix-ui/react-accordion": "1.3.1",
		"@radix-ui/react-checkbox": "1.4.1",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-dropdown-menu": "2.2.1",
		"@radix-ui/react-label": "2.1.17",
		"@radix-ui/react-popover": "1.3.1",
		"@radix-ui/react-progress": "1.2.1",
		"@radix-ui/react-select": "2.4.1",
		"@radix-ui/react-separator": "1.2.0",
		"@radix-ui/react-slot": "1.5.0",
		"@radix-ui/react-switch": "1.4.1",
		"@radix-ui/react-tooltip": "1.4.1",
		"@tanstack/react-query": "5.104.5",
		"@tanstack/react-query-devtools": "5.104.5",
		"@tanstack/react-table": "9.3.1",
		"@types/d3-geo": "3.1.1",
		"@types/luxon": "3.7.6",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"country-flag-icons": "1.6.20",
		"d3-geo": "3.1.1",
		"dayjs": "1.11.23",
		"flag-icons": "7.6.0",
		"i18n-iso-countries": "7.14.0",
		"i18next": "26.5.6",
		"lucide-react": "1.61.0",
		"luxon": "3.7.2",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-i18next": "17.1.3",
		"react-router-dom": "^7.18.4",
		"recharts": "3.10.1",
		"sonner": "2.0.8",
		"tailwind-merge": "3.7.0",
		"tailwindcss-animate": "^1.0.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@tailwindcss/postcss": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/coverage-v8": "^5.0.5",
		"globals": "17.13.0",
		"jsdom": "^30.1.3",
		"postcss": "8.5.31",
